{
  "plugins": ["unicorn", "typescript", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "react-in-jsx-scope": "off",
    "jsx-filename-extension": ["error", { "extensions": [".tsx"] }],
    "unbound-method": "off"
  }
}
